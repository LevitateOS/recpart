{
  "$comment": "Generated by `cargo xtask gen` from the tool's Rust output types. Do not edit.",
  "$defs": {
    "ChangeKind": {
      "description": "What apply does to one partition.",
      "oneOf": [
        {
          "const": "erased",
          "description": "Deleted (or lost with the old table); its data is gone.",
          "type": "string"
        },
        {
          "const": "created",
          "description": "New, formatted.",
          "type": "string"
        },
        {
          "const": "resized",
          "description": "Grown or shrunk with its filesystem; the data stays.",
          "type": "string"
        },
        {
          "const": "formatted",
          "description": "A new filesystem in place; its data is gone.",
          "type": "string"
        },
        {
          "const": "untouched",
          "description": "Left as it is.",
          "type": "string"
        }
      ]
    },
    "DiskSignature": {
      "description": "A signature on the whole disk, as `wipefs --no-act` reports it.",
      "properties": {
        "kind": {
          "description": "wipefs's TYPE: `crypto_LUKS`, `btrfs`, `LVM2_member`, `ext4`, ...",
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset_bytes": {
          "description": "Where the signature's magic is, in bytes from the start of the disk;\n0 when only lsblk's FSTYPE was readable (wipefs needs root).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "uuid": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "offset_bytes"
      ],
      "type": "object"
    },
    "DiskTarget": {
      "properties": {
        "logical_sector_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes"
      ],
      "type": "object"
    },
    "Filesystem": {
      "description": "The filesystems recpart creates. Each serializes as its blkid name.",
      "enum": [
        "vfat",
        "ext4",
        "swap"
      ],
      "type": "string"
    },
    "InstallMode": {
      "oneOf": [
        {
          "const": "ab",
          "description": "A/B immutable-ready layout: two root slots for atomic updates and rollback.",
          "type": "string"
        },
        {
          "const": "mutable",
          "description": "Classic layout with one mutable root.",
          "type": "string"
        }
      ]
    },
    "LayoutAction": {
      "description": "One action of a manual layout. `partition` is an existing partition's\nnumber from `inspect`; each partition takes at most one action. `role`\nand `mountpoint` (for `other`) say how the installed system uses it.",
      "oneOf": [
        {
          "description": "Leave the partition and its data as they are (an existing EFI\npartition, /home, or another system's partition).",
          "properties": {
            "action": {
              "const": "keep",
              "type": "string"
            },
            "mountpoint": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "partition": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Role"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "action",
            "partition"
          ],
          "type": "object"
        },
        {
          "description": "Remove the partition; its data is lost.",
          "properties": {
            "action": {
              "const": "delete",
              "type": "string"
            },
            "partition": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "action",
            "partition"
          ],
          "type": "object"
        },
        {
          "description": "A new partition in free space, formatted. `size_mb` unset takes the\nrest of the free gap; `start_mb` picks the gap (first fit when unset).\n`filesystem` defaults from the role (ext4 without one).",
          "properties": {
            "action": {
              "const": "create",
              "type": "string"
            },
            "filesystem": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Filesystem"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "label": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "mountpoint": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Role"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "size_mb": {
              "default": null,
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "start_mb": {
              "default": null,
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "description": "Grow or shrink the partition together with its filesystem, keeping\nits start and data. `size_mb` unset grows it into the free gap after it.",
          "properties": {
            "action": {
              "const": "resize",
              "type": "string"
            },
            "mountpoint": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "partition": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Role"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "size_mb": {
              "default": null,
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "action",
            "partition"
          ],
          "type": "object"
        },
        {
          "description": "Make a new filesystem on the partition, in place; its data is lost.",
          "properties": {
            "action": {
              "const": "format",
              "type": "string"
            },
            "filesystem": {
              "$ref": "#/$defs/Filesystem"
            },
            "label": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "mountpoint": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "partition": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Role"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "action",
            "partition",
            "filesystem"
          ],
          "type": "object"
        }
      ]
    },
    "LayoutRequest": {
      "description": "Partition sizes the caller asked for; unset sizes take the policy default.\nThe fields are also recpart's `--<field>` CLI flags.",
      "properties": {
        "efi_size_mb": {
          "description": "EFI partition size in MB",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_a_size_mb": {
          "description": "A/B slot A partition size in MB (ab mode only)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_b_size_mb": {
          "description": "A/B slot B partition size in MB (ab mode only)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_size_mb": {
          "description": "Mutable root partition size in MB (mutable mode only)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state_size_mb": {
          "description": "A/B state partition size in MB (ab mode only). Omit to use remaining space.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ManualLayout": {
      "additionalProperties": false,
      "description": "An explicit layout: what to do with each partition. Partitions no action\nnames are kept untouched. Sizes are MiB (1024 * 1024 bytes).",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/LayoutAction"
          },
          "type": "array"
        },
        "new_table": {
          "default": false,
          "description": "Replace the partition table with an empty GPT one, erasing every\npartition, before the `create` actions. Only `create` may follow.",
          "type": "boolean"
        },
        "swap_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/SwapFileRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A swap file in the installed system, in place of (or as well as) a\nswap partition."
        },
        "table_id": {
          "default": null,
          "description": "When set, the disk's table must still have this id (`inspect`'s\n`table_id`), so a plan made for one disk never edits another.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "actions"
      ],
      "type": "object"
    },
    "PartitionChange": {
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The partition after apply (`None` when it is erased)."
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The partition on the disk now (`None` when it is created)."
        },
        "change": {
          "$ref": "#/$defs/ChangeKind"
        },
        "device": {
          "type": "string"
        },
        "mountpoint": {
          "description": "Where the installed system mounts it (`None`: not mounted).",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "number",
        "device",
        "change"
      ],
      "type": "object"
    },
    "PartitionState": {
      "properties": {
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "fs_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_bytes",
        "size_bytes"
      ],
      "type": "object"
    },
    "PartitionTemplate": {
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/Filesystem"
        },
        "gpt_type": {
          "type": "string"
        },
        "index": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "mountpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "name",
        "filesystem",
        "label",
        "gpt_type",
        "mountpoint"
      ],
      "type": "object"
    },
    "ResolvedLayout": {
      "properties": {
        "efi_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "root_a_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_b_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "efi_size_mb"
      ],
      "type": "object"
    },
    "Role": {
      "description": "What the installed system uses a partition for. Each role has its mount\npoint; `other` takes the layout's `mountpoint`.",
      "oneOf": [
        {
          "const": "efi",
          "description": "The EFI system partition, mounted at /boot (vfat).",
          "type": "string"
        },
        {
          "const": "root",
          "description": "The one root of a mutable install, at / (ext4).",
          "type": "string"
        },
        {
          "const": "root_a",
          "description": "A/B root slot A, installed now and mounted at / (ext4).",
          "type": "string"
        },
        {
          "const": "root_b",
          "description": "A/B root slot B, left unmounted for updates (ext4).",
          "type": "string"
        },
        {
          "const": "state",
          "description": "The persistent /var: the A/B state partition, or a mutable install's own /var (ext4).",
          "type": "string"
        },
        {
          "const": "home",
          "description": "/home (ext4).",
          "type": "string"
        },
        {
          "const": "swap",
          "description": "A swap partition, activated with swapon.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Mounted at the action's `mountpoint`.",
          "type": "string"
        }
      ]
    },
    "SwapFileLocation": {
      "description": "Where a swap file goes: the root or the /var filesystem.",
      "enum": [
        "root",
        "var"
      ],
      "type": "string"
    },
    "SwapFilePlan": {
      "properties": {
        "path": {
          "description": "The file's path in the installed system (`/swapfile`, `/var/swapfile`).",
          "type": "string"
        },
        "size_mb": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_mb"
      ],
      "type": "object"
    },
    "SwapFileRequest": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/SwapFileLocation"
        },
        "size_mb": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size_mb",
        "location"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "disk": {
      "$ref": "#/$defs/DiskTarget"
    },
    "disk_serial": {
      "default": "",
      "description": "The serial of the disk the plan was made for (`inspect`'s\n`disk.serial`): with `disk` and `table_id`, it names the disk\n`apply --expect` must still find.",
      "type": "string"
    },
    "erased_signatures": {
      "default": [],
      "description": "What apply's `wipefs -a` erases besides the partitions (`inspect`'s\n`signatures`): listed whenever `wipes_disk`, so the confirm page can\nsay a LUKS container or a filesystem on the bare disk is lost. Empty\nwhen the plan keeps the table.",
      "items": {
        "$ref": "#/$defs/DiskSignature"
      },
      "type": "array"
    },
    "layout_request": {
      "$ref": "#/$defs/LayoutRequest"
    },
    "manual_layout": {
      "anyOf": [
        {
          "$ref": "#/$defs/ManualLayout"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The explicit layout (`--layout`) this plan came from; `None` for the\n`ab`/`mutable` templates."
    },
    "mode": {
      "$ref": "#/$defs/InstallMode"
    },
    "partitions": {
      "description": "The partitions the installed system uses, with their filesystem and\nmount point; a manual layout's other partitions are only in `summary`.",
      "items": {
        "$ref": "#/$defs/PartitionTemplate"
      },
      "type": "array"
    },
    "resolved_layout": {
      "$ref": "#/$defs/ResolvedLayout"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sfdisk_script": {
      "type": "string"
    },
    "summary": {
      "default": [],
      "description": "What happens to every partition, on the disk now and after apply, in\npartition-number order: the confirm page's list.",
      "items": {
        "$ref": "#/$defs/PartitionChange"
      },
      "type": "array"
    },
    "swap_file": {
      "anyOf": [
        {
          "$ref": "#/$defs/SwapFilePlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The swap file apply creates, if any."
    },
    "table_id": {
      "default": null,
      "description": "The partition table id the disk had when the plan was made\n(`inspect`'s `table_id`); `None` when it had no table, or no id.",
      "type": [
        "string",
        "null"
      ]
    },
    "wipes_disk": {
      "default": false,
      "description": "Apply erases the whole disk (`wipefs -a`) before writing the new\ntable: always for a template, and for a manual layout with `new_table`.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "layout_request",
    "resolved_layout",
    "disk",
    "partitions",
    "sfdisk_script"
  ],
  "title": "PartitionPlan",
  "type": "object"
}
