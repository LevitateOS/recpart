{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PartitionPlan",
  "type": "object",
  "properties": {
    "disk": {
      "$ref": "#/$defs/DiskTarget"
    },
    "layout_request": {
      "$ref": "#/$defs/LayoutRequest"
    },
    "mode": {
      "$ref": "#/$defs/InstallMode"
    },
    "partitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartitionTemplate"
      }
    },
    "resolved_layout": {
      "$ref": "#/$defs/ResolvedLayout"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sfdisk_script": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "layout_request",
    "resolved_layout",
    "disk",
    "partitions",
    "sfdisk_script"
  ],
  "$defs": {
    "DiskTarget": {
      "type": "object",
      "properties": {
        "logical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes"
      ]
    },
    "Filesystem": {
      "description": "The filesystems recpart creates.",
      "type": "string",
      "enum": [
        "vfat",
        "ext4"
      ]
    },
    "InstallMode": {
      "oneOf": [
        {
          "description": "A/B immutable-ready layout: two root slots for atomic updates and rollback.",
          "type": "string",
          "const": "ab"
        },
        {
          "description": "Classic layout with one mutable root.",
          "type": "string",
          "const": "mutable"
        }
      ]
    },
    "LayoutRequest": {
      "description": "Partition sizes the caller asked for; unset sizes take the policy default.\nThe fields are also recpart's `--<field>` CLI flags.",
      "type": "object",
      "properties": {
        "efi_size_mb": {
          "description": "EFI partition size in MB",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_a_size_mb": {
          "description": "A/B slot A partition size in MB (ab mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_b_size_mb": {
          "description": "A/B slot B partition size in MB (ab mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_size_mb": {
          "description": "Mutable root partition size in MB (mutable mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "state_size_mb": {
          "description": "A/B state partition size in MB (ab mode only). Omit to use remaining space.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "PartitionTemplate": {
      "type": "object",
      "properties": {
        "bootable": {
          "description": "The legacy-BIOS bootable flag (set on the ESP).",
          "type": "boolean"
        },
        "filesystem": {
          "$ref": "#/$defs/Filesystem"
        },
        "gpt_type": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "mountpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "name",
        "filesystem",
        "label",
        "gpt_type",
        "bootable",
        "mountpoint"
      ]
    },
    "ResolvedLayout": {
      "type": "object",
      "properties": {
        "efi_size_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "root_a_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_b_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "state_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "efi_size_mb"
      ]
    }
  }
}
