{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InspectResult",
  "description": "`recpart inspect`: one disk's partition table, its partitions and the free gaps.",
  "type": "object",
  "properties": {
    "disk": {
      "$ref": "#/$defs/DiskInventory"
    },
    "free": {
      "description": "Unpartitioned space of at least 1 MiB, aligned to 1 MiB, ordered by start.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/FreeGap"
      }
    },
    "partitions": {
      "description": "Ordered by start.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartitionInfo"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "table": {
      "$ref": "#/$defs/TableType"
    },
    "table_id": {
      "description": "The table's identifier (GPT disk GUID, or MBR disk id).",
      "type": [
        "string",
        "null"
      ]
    },
    "usable_end_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "usable_start_bytes": {
      "description": "The space partitions may use: after the GPT header (or the first MiB)\nand before the backup GPT, in bytes from the start of the disk.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "disk",
    "table",
    "usable_start_bytes",
    "usable_end_bytes",
    "partitions",
    "free"
  ],
  "$defs": {
    "DiskInventory": {
      "type": "object",
      "properties": {
        "logical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "read_only": {
          "type": "boolean"
        },
        "removable": {
          "type": "boolean"
        },
        "rotational": {
          "description": "Spinning disk; `false` for SSDs and virtual disks.",
          "type": "boolean"
        },
        "serial": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transport": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes",
        "model",
        "vendor",
        "serial",
        "transport",
        "rotational",
        "removable",
        "read_only"
      ]
    },
    "FreeGap": {
      "type": "object",
      "properties": {
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "start_bytes",
        "size_bytes"
      ]
    },
    "PartitionInfo": {
      "type": "object",
      "properties": {
        "attrs": {
          "description": "GPT attributes in sfdisk's notation (`RequiredPartition GUID:63`).",
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "type": "string"
        },
        "filesystem": {
          "description": "The filesystem blkid found (`ext4`, `vfat`, `ntfs`, `swap`, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "fs_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "fs_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "The GPT partition name.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "min_size_bytes": {
          "description": "The smallest and largest size recpart would resize it to, keeping its\nstart (the largest takes the free gap right after it); `None` when\nrecpart cannot resize this filesystem, or cannot read its used space.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mountpoints": {
          "description": "Where it is mounted now (empty when it is not).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "part_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type_guid": {
          "description": "GPT type GUID (upper case), or the MBR type byte (`0x83`).",
          "type": "string"
        },
        "used_bytes": {
          "description": "Space in use; `None` when it could not be read (an unmounted\nfilesystem needs root, or recpart has no probe for it).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "number",
        "device",
        "start_bytes",
        "size_bytes",
        "type_guid",
        "mountpoints"
      ]
    },
    "TableType": {
      "description": "The partition table on a disk.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "gpt"
          ]
        },
        {
          "description": "An MBR (DOS) table.",
          "type": "string",
          "const": "mbr"
        },
        {
          "description": "No partition table.",
          "type": "string",
          "const": "none"
        }
      ]
    }
  }
}
