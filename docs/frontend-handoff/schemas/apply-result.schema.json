{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplyResult",
  "type": "object",
  "properties": {
    "disk": {
      "$ref": "#/$defs/DiskTarget"
    },
    "disk_checks_skipped": {
      "description": "The dry run planned from a recorded inventory (`--inventory`), so\nthe live-disk checks behind `warnings` did not run.",
      "type": "boolean",
      "default": false
    },
    "dry_run": {
      "type": "boolean"
    },
    "formatted_devices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "$ref": "#/$defs/HandoffPayload"
    },
    "layout_request": {
      "$ref": "#/$defs/LayoutRequest"
    },
    "mode": {
      "$ref": "#/$defs/InstallMode"
    },
    "partition_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartitionTemplate"
      }
    },
    "resolved_layout": {
      "$ref": "#/$defs/ResolvedLayout"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommandRecord"
      }
    },
    "summary": {
      "description": "The plan's per-partition summary (as in the plan).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PartitionChange"
      }
    },
    "warnings": {
      "description": "In a dry run, the reasons a real apply would refuse this disk; empty when it would proceed.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "layout_request",
    "resolved_layout",
    "disk",
    "dry_run",
    "steps",
    "partition_map",
    "formatted_devices",
    "handoff",
    "warnings"
  ],
  "$defs": {
    "ChangeKind": {
      "description": "What apply does to one partition.",
      "oneOf": [
        {
          "description": "Deleted (or lost with the old table); its data is gone.",
          "type": "string",
          "const": "erased"
        },
        {
          "description": "New, formatted.",
          "type": "string",
          "const": "created"
        },
        {
          "description": "Grown or shrunk with its filesystem; the data stays.",
          "type": "string",
          "const": "resized"
        },
        {
          "description": "A new filesystem in place; its data is gone.",
          "type": "string",
          "const": "formatted"
        },
        {
          "description": "Left as it is.",
          "type": "string",
          "const": "untouched"
        }
      ]
    },
    "CommandRecord": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "phase": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "phase",
        "command",
        "program",
        "args",
        "dry_run"
      ]
    },
    "DiskTarget": {
      "type": "object",
      "properties": {
        "logical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes"
      ]
    },
    "Filesystem": {
      "description": "The filesystems recpart creates. Each serializes as its blkid name.",
      "type": "string",
      "enum": [
        "vfat",
        "ext4",
        "swap"
      ]
    },
    "HandoffPayload": {
      "type": "object",
      "properties": {
        "install_target": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "mode_context": {
          "$ref": "#/$defs/ModeContext"
        },
        "mount_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MountMapping"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "swaps": {
          "description": "Swap devices and files apply activated (`swapon`), as recfstab will\nfind them.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "mode",
        "install_target",
        "mount_map",
        "mode_context"
      ]
    },
    "InstallMode": {
      "oneOf": [
        {
          "description": "A/B immutable-ready layout: two root slots for atomic updates and rollback.",
          "type": "string",
          "const": "ab"
        },
        {
          "description": "Classic layout with one mutable root.",
          "type": "string",
          "const": "mutable"
        }
      ]
    },
    "LayoutRequest": {
      "description": "Partition sizes the caller asked for; unset sizes take the policy default.\nThe fields are also recpart's `--<field>` CLI flags.",
      "type": "object",
      "properties": {
        "efi_size_mb": {
          "description": "EFI partition size in MB",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_a_size_mb": {
          "description": "A/B slot A partition size in MB (ab mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_b_size_mb": {
          "description": "A/B slot B partition size in MB (ab mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_size_mb": {
          "description": "Mutable root partition size in MB (mutable mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "state_size_mb": {
          "description": "A/B state partition size in MB (ab mode only). Omit to use remaining space.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "ModeContext": {
      "description": "A/B facts of the layout (all `None` in mutable mode): which slot the\ninstall target is (\"A\"/\"B\"), the other slot, and each slot's partition.",
      "type": "object",
      "properties": {
        "inactive_slot_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "install_target_slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_a_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_b_device": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MountMapping": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "device"
      ]
    },
    "PartitionChange": {
      "type": "object",
      "properties": {
        "after": {
          "description": "The partition after apply (`None` when it is erased).",
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionState"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "description": "The partition on the disk now (`None` when it is created).",
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionState"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "$ref": "#/$defs/ChangeKind"
        },
        "device": {
          "type": "string"
        },
        "mountpoint": {
          "description": "Where the installed system mounts it (`None`: not mounted).",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "number",
        "device",
        "change"
      ]
    },
    "PartitionState": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "fs_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "start_bytes",
        "size_bytes"
      ]
    },
    "PartitionTemplate": {
      "type": "object",
      "properties": {
        "bootable": {
          "description": "The legacy-BIOS bootable flag (set on the ESP).",
          "type": "boolean"
        },
        "filesystem": {
          "$ref": "#/$defs/Filesystem"
        },
        "gpt_type": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "mountpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "name",
        "filesystem",
        "label",
        "gpt_type",
        "bootable",
        "mountpoint"
      ]
    },
    "ResolvedLayout": {
      "type": "object",
      "properties": {
        "efi_size_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "root_a_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_b_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "state_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "efi_size_mb"
      ]
    },
    "Role": {
      "description": "What the installed system uses a partition for. Each role has its mount\npoint; `other` takes the layout's `mountpoint`.",
      "oneOf": [
        {
          "description": "The EFI system partition, mounted at /boot (vfat).",
          "type": "string",
          "const": "efi"
        },
        {
          "description": "The one root of a mutable install, at / (ext4).",
          "type": "string",
          "const": "root"
        },
        {
          "description": "A/B root slot A, installed now and mounted at / (ext4).",
          "type": "string",
          "const": "root_a"
        },
        {
          "description": "A/B root slot B, left unmounted for updates (ext4).",
          "type": "string",
          "const": "root_b"
        },
        {
          "description": "The persistent /var: the A/B state partition, or a mutable install's own /var (ext4).",
          "type": "string",
          "const": "state"
        },
        {
          "description": "/home (ext4).",
          "type": "string",
          "const": "home"
        },
        {
          "description": "A swap partition, activated with swapon.",
          "type": "string",
          "const": "swap"
        },
        {
          "description": "Mounted at the action's `mountpoint`.",
          "type": "string",
          "const": "other"
        }
      ]
    }
  }
}
