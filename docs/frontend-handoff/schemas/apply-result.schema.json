{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplyResult",
  "type": "object",
  "properties": {
    "disk": {
      "$ref": "#/$defs/DiskTarget"
    },
    "dry_run": {
      "type": "boolean"
    },
    "formatted_devices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "$ref": "#/$defs/HandoffPayload"
    },
    "layout_request": {
      "$ref": "#/$defs/LayoutRequest"
    },
    "mode": {
      "$ref": "#/$defs/InstallMode"
    },
    "partition_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartitionTemplate"
      }
    },
    "resolved_layout": {
      "$ref": "#/$defs/ResolvedLayout"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommandRecord"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "layout_request",
    "resolved_layout",
    "disk",
    "dry_run",
    "steps",
    "partition_map",
    "formatted_devices",
    "handoff",
    "warnings"
  ],
  "$defs": {
    "CommandRecord": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "phase": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "phase",
        "command",
        "program",
        "args",
        "dry_run"
      ]
    },
    "DiskTarget": {
      "type": "object",
      "properties": {
        "logical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes"
      ]
    },
    "HandoffPayload": {
      "type": "object",
      "properties": {
        "install_target": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "mode_context": {
          "$ref": "#/$defs/ModeContext"
        },
        "mount_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MountMapping"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "mode",
        "install_target",
        "mount_map",
        "mode_context"
      ]
    },
    "InstallMode": {
      "type": "string",
      "enum": [
        "ab",
        "mutable"
      ]
    },
    "LayoutRequest": {
      "description": "Partition sizes the caller asked for; unset sizes take the policy default.\nThe fields are also recpart's `--<field>` CLI flags.",
      "type": "object",
      "properties": {
        "efi_size_mb": {
          "description": "EFI partition size in MB",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_a_size_mb": {
          "description": "A/B slot A partition size in MB (ab mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_b_size_mb": {
          "description": "A/B slot B partition size in MB (ab mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_size_mb": {
          "description": "Mutable root partition size in MB (mutable mode only)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "state_size_mb": {
          "description": "A/B state partition size in MB (ab mode only). Omit to use remaining space.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "ModeContext": {
      "description": "A/B facts of the layout (all `None` in mutable mode): which slot the\ninstall target is (\"A\"/\"B\"), the other slot, and each slot's partition.",
      "type": "object",
      "properties": {
        "inactive_slot_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "install_target_slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_a_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_b_device": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MountMapping": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "device"
      ]
    },
    "PartitionTemplate": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "string"
        },
        "gpt_type": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "mountpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "name",
        "filesystem",
        "label",
        "gpt_type",
        "mountpoint"
      ]
    },
    "ResolvedLayout": {
      "type": "object",
      "properties": {
        "efi_size_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "root_a_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_b_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "root_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "state_size_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "efi_size_mb"
      ]
    }
  }
}
