{
  "$comment": "Generated by `cargo xtask gen` from the tool's Rust output types. Do not edit.",
  "$defs": {
    "ChangeKind": {
      "description": "What apply does to one partition.",
      "oneOf": [
        {
          "const": "erased",
          "description": "Deleted (or lost with the old table); its data is gone.",
          "type": "string"
        },
        {
          "const": "created",
          "description": "New, formatted.",
          "type": "string"
        },
        {
          "const": "resized",
          "description": "Grown or shrunk with its filesystem; the data stays.",
          "type": "string"
        },
        {
          "const": "formatted",
          "description": "A new filesystem in place; its data is gone.",
          "type": "string"
        },
        {
          "const": "untouched",
          "description": "Left as it is.",
          "type": "string"
        }
      ]
    },
    "CommandRecord": {
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "phase": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "status": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "phase",
        "command",
        "program",
        "args",
        "dry_run"
      ],
      "type": "object"
    },
    "DiskTarget": {
      "properties": {
        "logical_sector_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes"
      ],
      "type": "object"
    },
    "Filesystem": {
      "description": "The filesystems recpart creates. Each serializes as its blkid name.",
      "enum": [
        "vfat",
        "ext4",
        "swap"
      ],
      "type": "string"
    },
    "HandoffPayload": {
      "properties": {
        "install_target": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "mode_context": {
          "$ref": "#/$defs/ModeContext"
        },
        "mount_map": {
          "items": {
            "$ref": "#/$defs/MountMapping"
          },
          "type": "array"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "swaps": {
          "default": [],
          "description": "Swap devices and files apply activated (`swapon`), as recfstab will\nfind them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "install_target",
        "mount_map",
        "mode_context"
      ],
      "type": "object"
    },
    "InstallMode": {
      "oneOf": [
        {
          "const": "ab",
          "description": "A/B immutable-ready layout: two root slots for atomic updates and rollback.",
          "type": "string"
        },
        {
          "const": "mutable",
          "description": "Classic layout with one mutable root.",
          "type": "string"
        }
      ]
    },
    "LayoutRequest": {
      "description": "Partition sizes the caller asked for; unset sizes take the policy default.\nThe fields are also recpart's `--<field>` CLI flags.",
      "properties": {
        "efi_size_mb": {
          "description": "EFI partition size in MiB (1024 * 1024 bytes)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_a_size_mb": {
          "description": "A/B slot A partition size in MiB (ab mode only)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_b_size_mb": {
          "description": "A/B slot B partition size in MiB (ab mode only)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_size_mb": {
          "description": "Mutable root partition size in MiB (mutable mode only)",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state_size_mb": {
          "description": "A/B state partition size in MiB (ab mode only). Omit to use remaining space.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ModeContext": {
      "description": "A/B facts of the layout (all `None` in mutable mode): which slot the\ninstall target is (\"A\"/\"B\"), the other slot, and each slot's partition.",
      "properties": {
        "inactive_slot_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "install_target_slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_a_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_b_device": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MountMapping": {
      "properties": {
        "device": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "device"
      ],
      "type": "object"
    },
    "PartitionChange": {
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The partition after apply (`None` when it is erased)."
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The partition on the disk now (`None` when it is created)."
        },
        "change": {
          "$ref": "#/$defs/ChangeKind"
        },
        "device": {
          "type": "string"
        },
        "mountpoint": {
          "description": "Where the installed system mounts it (`None`: not mounted).",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "number",
        "device",
        "change"
      ],
      "type": "object"
    },
    "PartitionState": {
      "properties": {
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "fs_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_bytes",
        "size_bytes"
      ],
      "type": "object"
    },
    "PartitionTemplate": {
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/Filesystem"
        },
        "gpt_type": {
          "type": "string"
        },
        "index": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "mountpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "name",
        "filesystem",
        "label",
        "gpt_type",
        "mountpoint"
      ],
      "type": "object"
    },
    "ResolvedLayout": {
      "properties": {
        "efi_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/InstallMode"
        },
        "root_a_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_b_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state_size_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "efi_size_mb"
      ],
      "type": "object"
    },
    "Role": {
      "description": "What the installed system uses a partition for. Each role has its mount\npoint; `other` takes the layout's `mountpoint`.",
      "oneOf": [
        {
          "const": "efi",
          "description": "The EFI system partition, mounted at /boot (vfat).",
          "type": "string"
        },
        {
          "const": "root",
          "description": "The one root of a mutable install, at / (ext4).",
          "type": "string"
        },
        {
          "const": "root_a",
          "description": "A/B root slot A, installed now and mounted at / (ext4).",
          "type": "string"
        },
        {
          "const": "root_b",
          "description": "A/B root slot B, left unmounted for updates (ext4).",
          "type": "string"
        },
        {
          "const": "state",
          "description": "The persistent /var: the A/B state partition, or a mutable install's own /var (ext4).",
          "type": "string"
        },
        {
          "const": "home",
          "description": "/home (ext4).",
          "type": "string"
        },
        {
          "const": "swap",
          "description": "A swap partition, activated with swapon.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Mounted at the action's `mountpoint`.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "disk": {
      "$ref": "#/$defs/DiskTarget"
    },
    "disk_checks_skipped": {
      "default": false,
      "description": "The dry run planned from a recorded inventory (`--inventory`), so\nthe live-disk checks behind `warnings` did not run.",
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "formatted_devices": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "handoff": {
      "$ref": "#/$defs/HandoffPayload"
    },
    "layout_request": {
      "$ref": "#/$defs/LayoutRequest"
    },
    "mode": {
      "$ref": "#/$defs/InstallMode"
    },
    "partition_map": {
      "items": {
        "$ref": "#/$defs/PartitionTemplate"
      },
      "type": "array"
    },
    "resolved_layout": {
      "$ref": "#/$defs/ResolvedLayout"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/CommandRecord"
      },
      "type": "array"
    },
    "summary": {
      "default": [],
      "description": "The plan's per-partition summary (as in the plan).",
      "items": {
        "$ref": "#/$defs/PartitionChange"
      },
      "type": "array"
    },
    "warnings": {
      "description": "In a dry run, the reasons a real apply would refuse this disk; empty when it would proceed.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "layout_request",
    "resolved_layout",
    "disk",
    "dry_run",
    "steps",
    "partition_map",
    "formatted_devices",
    "handoff",
    "warnings"
  ],
  "title": "ApplyResult",
  "type": "object"
}
