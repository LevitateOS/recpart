{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiskListResult",
  "type": "object",
  "properties": {
    "disks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiskInventory"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "disks"
  ],
  "$defs": {
    "DiskInventory": {
      "type": "object",
      "properties": {
        "logical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "physical_sector_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "read_only": {
          "type": "boolean"
        },
        "removable": {
          "type": "boolean"
        },
        "rotational": {
          "description": "Spinning disk; `false` for SSDs and virtual disks.",
          "type": "boolean"
        },
        "serial": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transport": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "logical_sector_bytes",
        "physical_sector_bytes",
        "model",
        "vendor",
        "serial",
        "transport",
        "rotational",
        "removable",
        "read_only"
      ]
    }
  }
}
